# Copy to dashboard/.env (git-ignored). Never commit real credentials.
MQTT_HOST=mqtt.example.com
MQTT_PORT=8883
MQTT_USER=user-or-token
MQTT_PASSWORD=password-or-secret
MQTT_TLS=1
MQTT_CA_FILE=
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789
# 1 = print messages instead of sending (for testing without a bot)
NOTIFIER_DRY_RUN=0
